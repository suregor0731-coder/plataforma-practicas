# Copie este archivo como ".env" y ajuste los valores a su equipo.
# El archivo ".env" no se sube al repositorio.

PORT=3000

# Base de datos de la aplicación (la que levanta docker-compose.yml)
DATABASE_URL=postgres://practicas:practicas@localhost:5432/practicas

# Base de datos exclusiva para las pruebas de integración (se borra y se recrea en cada corrida)
DATABASE_URL_TEST=postgres://practicas:practicas@localhost:5432/practicas_test

# Clave con la que se firman los tokens JWT. Use una cadena larga y aleatoria.
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRA_SEGUNDOS=7200

# Solo si la base de datos está en la nube y exige conexión cifrada:
# DATABASE_SSL=true
